{
  "name": "potvrdio/woocommerce-viber-cod",
  "description": "Potvrdio.online - Viber COD Verification & Address Correction for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "php-stubs/woocommerce-stubs": "^8.0",
    "squizlabs/php_codesniffer": "^3.9",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "analyze": "vendor/bin/phpstan analyze --memory-limit=2G",
    "lint": "vendor/bin/phpcs -p -s"
  }
}
