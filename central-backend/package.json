{
  "name": "potvrdio-central-backend",
  "version": "1.0.0",
  "description": "Central Server API, Viber Messaging Queue, & Billing Engine for Potvrdio.online Micro-SaaS",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test:flow": "ts-node-dev --transpile-only scripts/simulate-order-flow.ts",
    "test:gateway": "ts-node-dev --transpile-only scripts/test-messaging-gateway.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
